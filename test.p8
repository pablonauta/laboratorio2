pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- main

function _init()
	ents={}
	mundo=crear_mundo_1()
	jug=make_jugador()
	mal=make_malandro()
end

function _update()
	for e in all(ents) do
		e.upd()
	end
end

function _draw()
	cls()

	dibujar_mundo(mundo)

	for e in all(ents) do
		e.drw()
	end

end
-->8
-- mundo

function crear_mundo_1()
	local w={}

	w.tipo="calle"

	w.ancho=128*3

	w.y_min=70
	w.y_max=105

	w.color=10

	return w
end

function crear_mundo_2()
	local w={}

	w.tipo="calle"

	w.ancho=128*5

	w.y_min=60
	w.y_max=95

	w.color=8

	return w
end

function dibujar_mundo(w)

	rectfill(
		0,
		w.y_min,
		w.ancho,
		w.y_max,
		w.color
	)

end
-->8
function make_entidad()

 local e={}

 e.x=0
 e.y=0
 e.z=0
 
 e.dx=0
 e.dy=0
 
 e.vel=1
 
 e.vida=1
 e.atacando=false
 e.t_ataque=0
 e.danio=1
 
 e.estado="quieto"
 
 e.f=1
 e.df=0.15
 e.fs={1}

 e.flip=false
 e.spr=1

 e.upd=function()
  
  if e.dx < 0 then
   e.flip=true
  elseif e.dx > 0 then
   e.flip=false
  end
  
  e.x+=e.dx
  e.y+=e.dy
  
  e.f+=e.df

  if e.f>#e.fs then
   e.f=1
  end
 
 end
      
 e.drw=function()
  spr(e.fs[flr(e.f)],e.x,e.y-e.z,2,2,e.flip)
 end

 add(ents,e)

 return e

end
-->8
-- jugador

function make_jugador()

 local j=make_entidad()

 j.ancho=16
 j.alto=16

 j.x=64
 j.y=90

 j.vel=1
 
 j.fs={1}

 j.vz=0
 j.salto=4
 j.gravedad=0.4
 
 j.atacando=false
 j.t_ataque=0
 j.estado="quieto"
 
 -- hurtbox del jugador
	j.bb={
 x1=4,
 y1=-16,
 x2=12,
 y2=0
	}

 local upd_base=j.upd

 j.upd=function()

  j.dx=0
  j.dy=0

  if btn(0) then
   j.dx=-j.vel
   j.flip=true
  end

  if btn(1) then
   j.dx=j.vel
   j.flip=false
  end

  if btn(2) then
   j.dy=-j.vel
  end

  if btn(3) then
   j.dy=j.vel
  end

  if btnp(5) and not j.atacando then
   j.atacando=true
   j.t_ataque=8
  end
  
  if btnp(4) and j.z==0 then
   j.vz=j.salto
  end

  j.z+=j.vz
  j.vz-=j.gravedad

  if j.z<0 then
   j.z=0
   j.vz=0
  end
  
  if j.atacando then
   j.estado="atacando"

  elseif j.z > 0 then
   j.estado="saltando"

  elseif j.dx != 0 or j.dy != 0 then
   j.estado="caminando"

  else
   j.estado="quieto"
  end

  if j.estado=="atacando" then
   j.t_ataque-=1
 
	  if j.t_ataque > 5 then
	   j.fs={73}
	  elseif j.t_ataque > 2 then
	    j.fs={75}
	  else
	   j.fs={73}
	  end

  j.df=0
  j.f=1

  if j.t_ataque<=0 then
   j.atacando=false
  
 	end

  -- caminando
  elseif j.estado=="caminando" then
   j.fs={3,33,35,33}
   j.df=0.10
  
  -- saltando
  elseif j.estado=="saltando" then
   j.fs={1}
   j.df=0
   j.f=1
  
  elseif j.estado=="quieto" then
   j.fs={1}
   j.df=0
   j.f=1
  end
 
  upd_base()

  if j.x<0 then
   j.x=0
  end

  if j.x>mundo.ancho-j.ancho then
   j.x=mundo.ancho-j.ancho
  end

  if j.y<mundo.y_min then
   j.y=mundo.y_min
  end

  if j.y>mundo.y_max then
   j.y=mundo.y_max
  end

 end

 j.drw=function()
  
  draw_ent(j)
	 
	 -- hurt box
	 draw_hb(j,8)
	 
	 -- caja sprite
  draw_bb(j,11)
 
 end

 return j

end
-->8
-- malandros

function make_malandro()

 local m=make_entidad()

 m.x=110
 m.y=90

 m.ancho=16
 m.alto=16

 m.vel=0.5
 m.dx=-m.vel

 m.estado="patrull"

 -- hurt box
 m.bb={
 x1=3,
 y1=-16,
 x2=13,
 y2=0
 }

 local upd_base=m.upd

 m.upd=function()

  -- estados
  if m.estado=="patrull" then

   if m.x < 0 then
    m.dx=m.vel
   end

   if m.x > 120 then
    m.dx=-m.vel
   end

   -- caminando
   m.fs={10,40,10}
   m.df=0.10

  elseif m.estado=="quieto" then

   m.dx=0

   -- quieto
   m.fs={8}
   m.df=0
   m.f=1

  end

  upd_base()

 end

 -- draw
 local drw_base=m.drw

 m.drw=function()

  draw_ent(m)

  -- hurt box
  draw_hb(m,8)
  
  -- tamanio del sprite
  draw_bb(m,11) 
  
 end

 return m

end
-->8
-- helpers
function sx(e)
 return e.x
end

function sy(e)
 return e.y-e.alto-e.z
end

function draw_ent(e)
 spr(
  e.fs[flr(e.f)],
  sx(e),
  sy(e),
  2,2,
  e.flip
 )
end

function draw_hb(e,c)

 rect(
  e.x+e.bb.x1,
  e.y+e.bb.y1-e.z,
  e.x+e.bb.x2,
  e.y+e.bb.y2-e.z,
  c)

end

function draw_bb(e,c)

 rect(
  sx(e),
  sy(e),
  sx(e)+e.ancho,
  sy(e)+e.alto,
  c)

end


