pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- main

function _init()
	ents={}
	mundo=crear_mundo_1()
	jug=make_jugador()
	mal=make_malandro()
end

function _update()
	for e in all(ents) do
		e.upd()
	end
end

function _draw()
	cls()

	dibujar_mundo(mundo)

	-- ordenar por patitas
 ordenar_y()
	
	for e in all(ents) do
		e.drw()
	end

end
-->8
-- mundo

function crear_mundo_1()
	local w={}

	w.tipo="calle"

	w.ancho=128*3

	w.y_min=70
	w.y_max=105

	w.color=10

	return w
end

function crear_mundo_2()
	local w={}

	w.tipo="calle"

	w.ancho=128*5

	w.y_min=60
	w.y_max=95

	w.color=8

	return w
end

function dibujar_mundo(w)

	rectfill(
		0,
		w.y_min,
		w.ancho,
		w.y_max,
		w.color
	)

end
-->8
function make_entidad()

 local e={}

 e.x=0
 e.y=0
 e.z=0
 
 e.dx=0
 e.dy=0
 
 e.vel=1
 
 e.vida=1
 e.atacando=false
 e.t_ataque=0
 e.danio=1
 
 e.estado="quieto"
 
 e.f=1
 e.df=0.15
 e.fs={1}

 e.flip=false
 e.spr=1

 e.upd=function()
  
  if e.dx < 0 then
   e.flip=true
  elseif e.dx > 0 then
   e.flip=false
  end
  
  e.x+=e.dx
  e.y+=e.dy
  
  e.f+=e.df

  if e.f>#e.fs then
   e.f=1
  end
 
 end
      
 e.drw=function()
  spr(e.fs[flr(e.f)],e.x,e.y-e.z,2,2,e.flip)
 end

 add(ents,e)

 return e

end
-->8
-- jugador

function make_jugador()

 local j=make_entidad()

 j.ancho=16
 j.alto=16

 j.x=64
 j.y=90
 
 j.offx=0
 j.offy=0

 j.vel=1
 
 j.fs={1}

 j.vz=0
 j.salto=4
 j.gravedad=0.4
 
 j.atacando=false
 j.t_ataque=0
 j.estado="quieto"
 j.t_estado=0
 j.vida=100
 j.t_danio=0
 
 -- hurtbox del jugador
	j.bb={
     x1=4,
     y1=-16,
     x2=12,
     y2=0}
 
 local upd_base=j.upd

 j.upd=function()

  j.dx=0
  j.dy=0
  
  if j.t_danio>0 then
   j.t_danio-=1
  end
  
  -- detectar golpes enemigos
  if j.t_danio<=0 then
   for e in all(ents) do
    if e.hb and colision_hb_bb(e,j) then
     j.vida-=10
     j.t_danio=30
     j.estado="golpeado"
     j.t_estado=12
     break
    end
   end
  end

  if btn(0) then
   j.dx=-j.vel
   j.flip=true
  end

  if btn(1) then
   j.dx=j.vel
   j.flip=false
  end

  if btn(2) then
   j.dy=-j.vel
  end

  if btn(3) then
   j.dy=j.vel
  end

  if btnp(5) and not j.atacando then
   j.atacando=true
   j.t_ataque=8
   make_golpe(j)
  end
  
  if btnp(4) and j.z==0 then
   j.vz=j.salto
  end
  
  if j.flip then
   j.offx=0
  else
   j.offx=1
  end

  j.z+=j.vz
  j.vz-=j.gravedad
  
  if j.z<0 then
   j.z=0
   j.vz=0
  end


  if j.estado=="golpeado" then
  -- no pisar golpeado
  elseif j.atacando then
   j.estado="atacando"

  elseif j.z > 0 then
   j.estado="saltando"

  elseif j.dx != 0 or j.dy != 0 then
   j.estado="caminando"

  else
   j.estado="quieto"
  end

  if j.estado=="golpeado" then
		 j.t_estado-=1
		 j.fs={1}
		 j.df=0
		 j.f=1

 	if j.t_estado<=0 then
  	j.estado="quieto"
 	end

	elseif j.estado=="atacando" then

 	j.t_ataque-=1
 
	 if j.t_ataque > 5 then
	  j.fs={73}
	 elseif j.t_ataque > 2 then
	  j.fs={75}
	 else
	  j.fs={73}
	 end

  j.df=0
  j.f=1

  if j.t_ataque<=0 then
   j.atacando=false
  
 	end

  -- caminando
  elseif j.estado=="caminando" then
   j.fs={3,33,35,33}
   j.df=0.10
  
  -- saltando
  elseif j.estado=="saltando" then
   j.fs={1}
   j.df=0
   j.f=1
  
  elseif j.estado=="quieto" then
   j.fs={1}
   j.df=0
   j.f=1
  end
 
  upd_base()

  if j.x<0 then
   j.x=0
  end

  if j.x>mundo.ancho-j.ancho then
   j.x=mundo.ancho-j.ancho
  end

  if j.y<mundo.y_min then
   j.y=mundo.y_min
  end

  if j.y>mundo.y_max then
   j.y=mundo.y_max
  end

 end

 j.drw=function()
  
  draw_ent(j)
	 
	 -- hurt box
	 draw_hurtbox(j,8)
	 
	 -- caja sprite
  draw_sprite_box(j,11)
  
  print("vida: "..jug.vida,2,2,11)
 
 end

 return j

end
-->8
-- malandros

function make_malandro()

 local m=make_entidad()

 m.x=110
 m.y=90
 m.z=0

 m.ancho=16
 m.alto=16
 
 m.offx=0
 m.offy=0

 m.vel=0.5
 m.dx=-m.vel
 
 m.vida=8
 m.t_estado=0

 m.estado="patrull"
 m.alcance=12
 m.t_ataque=0
 
 -- hurt box
 m.bb={
 x1=3,
 y1=-16,
 x2=13,
 y2=0
 }

 local upd_base=m.upd

m.upd=function()

-- estados
if m.estado=="patrull" then
  
  m.dy=0

 if m.x<0 then
  m.dx=m.vel
 end

 if m.x>120 then
  m.dx=-m.vel
 end

 m.fs={10,40,10}
 m.df=0.10

 if abs(m.x-jug.x)<m.alcance then
  m.estado="alineando"
  m.dx=0
 end

elseif m.estado=="quieto" then

 m.dx=0
 m.fs={8}
 m.df=0
 m.f=1

elseif m.estado=="alineando" then

 m.dx=0
 m.fs={10,40,10}
 m.df=0.10

 if m.x<jug.x then
  m.flip=false
 else
  m.flip=true
 end

 if abs(m.y-jug.y)>2 then
  if m.y<jug.y then
   m.dy=0.3
  else
   m.dy=-0.3
  end
 else
  m.dy=0
  m.estado="atacando"
  m.t_estado=30
 end
 
elseif m.estado=="atacando" then

 m.dx=0
 m.dy=0

 if m.t_estado > 20 then
  m.fs={42}

 elseif m.t_estado > 10 then
  m.fs={105}

 else
  m.fs={42}
 end

 m.df=0
 m.f=1

 m.t_estado-=1

 if m.t_estado<22 and m.t_estado>10 then

  if m.flip then
   m.hb={x1=-4,
   						y1=-12,
   						x2=6,
   						y2=-8}
  else
   m.hb={x1=10,
   						y1=-12,
   						x2=20,
   						y2=-8}
  end

 else
  m.hb=nil
 end

 if m.t_estado<=0 then
  m.hb=nil
  m.estado="espera"
  m.t_estado=30
 end

elseif m.estado=="espera" then

 m.dx=0
 m.dy=0
 m.fs={8}
 m.df=0
 m.f=1

 m.t_estado-=1

 if m.t_estado<=0 then
 	m.estado="patrull"

	 if m.flip then
	  m.dx=-m.vel
	 else
	  m.dx=m.vel
	 end

 end

elseif m.estado=="golpeado" then

 m.dx=0
 m.dy=0
 m.fs={12,107}
 m.df=0.15

 m.t_estado-=1

 if m.t_estado<=0 then
  m.estado="patrull"

  if m.flip then
   m.dx=-m.vel
  else
   m.dx=m.vel
  end
 end

elseif m.estado=="caido" then

 m.dx=0
 m.dy=0
 m.fs={109}
 m.df=0
 m.f=1

 m.t_estado-=1

 if m.t_estado<=0 then
  del(ents,m)
 end

end

 upd_base()

 if m.flip then
  m.offx=0
 else
  m.offx=1
 end

 -- detectar golpes
 if m.estado!="caido" then
  for e in all(ents) do
   if e!=m and e.hb and colision_hb_bb(e,m) then
    del(ents,e)
    m.vida-=1

    if m.vida<=0 then
     m.estado="caido"
     m.t_estado=120
    else
     m.estado="golpeado"
     m.t_estado=12
    end
   end
  end
 end

end

 -- draw
 m.drw=function()

  draw_ent(m)

  -- hurt box
  draw_hurtbox(m,8)
  
  -- tamanio del sprite
  draw_sprite_box(m,11) 
  
  -- hit box
  if m.hb then
   draw_hitbox(m,9)
  end

 end

 return m

end
-->8
-- helpers
function sx(e)
 return e.x
end

function sy(e)
 return e.y-e.alto-e.z
end

function draw_ent(e)

 local ox=e.offx or 0
 local oy=e.offy or 0

 spr(
  e.fs[flr(e.f)],
  sx(e)+ox,
  sy(e)+oy,
  2,2,
  e.flip)

end

function draw_sprite_box(e,c)

 rect(
  sx(e),
  sy(e),
  sx(e)+e.ancho,
  sy(e)+e.alto,
  c)

end

function draw_hurtbox(e,c)
 rect(
  e.x+e.bb.x1,
  e.y+e.bb.y1-e.z,
  e.x+e.bb.x2,
  e.y+e.bb.y2-e.z,
  c)
end

function draw_hitbox(e,c)
 rect(
  e.x+e.hb.x1,
  e.y+e.hb.y1-e.z,
  e.x+e.hb.x2,
  e.y+e.hb.y2-e.z,
  c)
end

function colision_hb_bb(a,b)

 return
  a.x+a.hb.x1 < b.x+b.bb.x2 and
  a.x+a.hb.x2 > b.x+b.bb.x1 and
  a.y+a.hb.y1-a.z < b.y+b.bb.y2-b.z and
  a.y+a.hb.y2-a.z > b.y+b.bb.y1-b.z

end

-- burbujeador system
function ordenar_y()

 for i=1,#ents-1 do

  for j=1,#ents-i do

   if ents[j].y > ents[j+1].y then

    local tmp=ents[j]
    ents[j]=ents[j+1]
    ents[j+1]=tmp

   end

  end

 end

end

-->8
-- ataques

function make_golpe(j)

 local g={}

 g.x=j.x
 g.y=j.y
 g.z=j.z or 0

 g.t=6

 if j.flip then
 g.hb={
  x1=-6,
  y1=-14,
  x2=4,
  y2=-4}
	else
	 g.hb={
	  x1=12,
	  y1=-14,
	  x2=22,
   y2=-4}
	end

 g.upd=function()
  g.t-=1

  if g.t<=0 then
   del(ents,g)
  end
 end

 g.drw=function()
  draw_hitbox(g,9)
 end

 add(ents,g)

 return g

end
