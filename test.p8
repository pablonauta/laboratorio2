pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- main

modo="intro"

dificultad="normal"
max_malandros=2

colores_malandro={8,11,12,14}
sig_color=1

emboscada_z1=false

spawns_zona1={
 {80,90,11},

 {180,80,12},
 {180,100,14},

 {280,75,8},
 {300,95,10},

 {380,80,11},
 {380,100,12},

 {460,90,14}
}

spawns_emboscada_z1={
 {365,75,11},
 {380,85,12},
 {395,95,14},
 {410,90,8}
}

spawns_inicio_z1={
 {-20,75,11},
 {-35,85,12},
 {-50,95,14},
 {-65,90,8}
}

emboscada_inicio_z1=false
t_emboscada_inicio=120


function _init()

 cam_x=0
 modo="intro"
 ents={}

end

function _update()

 if modo=="intro" then
  update_intro()
  return
 end

 if modo=="juego" then
  update_juego()
  return
 end
 
 if modo=="game_over" then
  update_game_over()
  return
 end
 
 if modo=="victoria" then
  update_victoria()
  return
 end

end

function update_intro()

 if btnp(4) or btnp(5) then
  iniciar_juego()
  modo="juego"
 end

end

-------------------------------
-------------------------------
function update_juego()

 for e in all(ents) do
  e.upd()
 end
 
 actualizar_camara()
 
 -- emboscada temprana zona 1
	if zona==1
	and not emboscada_inicio_z1 then
	
	 t_emboscada_inicio-=1
	 
	
	 if t_emboscada_inicio<=0 then
	
	  for s in all(spawns_inicio_z1) do
	   make_malandro(s[1],s[2],s[3])
	  end
	
	  emboscada_inicio_z1=true
	 end
	
	end
 

 -- emboscada final zona 1
 if zona==1
 and not emboscada_z1
 and jug.x>260 then

  for s in all(spawns_emboscada_z1) do
   make_malandro(s[1],s[2],s[3])
  end

  emboscada_z1=true
 end
 
 -- pasar a zona 2
 if zona==1 
 and emboscada_z1
 and enemigos_vivos()==0 
 and jug.x>350 then
 
  cargar_zona(2)
  return
 
 end

 -- victoria en zona 2
 if zona==2 
 and enemigos_vivos()==0 then
  
  modo="victoria"
  return
  
 end

end

function draw_victoria()

 cls()
 print("archivo recuperado",24,50,11)
 print("victoria",46,65,7)
 print("press x or o",34,82,6)

end

function _draw()

 cls()

 if modo=="intro" then
  draw_intro()
  return
 end

 if modo=="juego" then
  draw_juego()
  return
 end
 
 if modo=="game_over" then
  draw_game_over()
  return
 end
 
 if modo=="victoria" then
  draw_victoria()
  return
 end


end

function draw_intro()

 print("el archivo perdido",30,50,7)
 print("press x or o",32,65,6)

end

function draw_juego()

 dibujar_cielo()

 camera(cam_x,0)

 dibujar_mundo(mundo)

 ordenar_y()

 for e in all(ents) do
  e.drw()
 end
 
 dibujar_frente(mundo)
 
 camera()
 
 dibujar_hud()

end

function iniciar_juego()
 
 if dificultad=="facil" then
  max_malandros=2
 elseif dificultad=="normal" then
  max_malandros=6
 else
  max_malandros=10
 end

 jefe_muerto=false
 cargar_zona(1)

end

function cargar_zona(n)

 local vida=100
 
 if jug then
  vida=jug.vida
 end

 zona=n
 ents={}
 cam_x=0

 if zona==1 then
  emboscada_z1=false
  t_emboscada_inicio=30
  emboscada_inicio_z1=false
  mundo=crear_mundo_1()
  jug=make_jugador()
  jug.vida=vida

  for s in all(spawns_zona1) do
   make_malandro(s[1],s[2],s[3])
  end
  
 end

 if zona==2 then

  mundo=crear_mundo_2()

  jug=make_jugador()
  jug.vida=vida

  make_malandro()
  
  make_nierilander(260,45)
 end

end

function update_game_over()

 if btnp(4) or btnp(5) then

  cargar_zona(zona)
  jug.vida=100
  modo="juego"

 end

end

function draw_game_over()

 draw_juego()
 
 camera()

 print("game over",45,55,8)
 print("press x or o",34,70,6)

end
