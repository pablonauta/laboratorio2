-- malandros

function make_malandro()

 local m=make_entidad()
 
 m.tipo="malandro"

 m.x=110
 m.y=90
 m.z=0

 m.ancho=16
 m.alto=16
 
 m.offx=0
 m.offy=0

 m.vel=0.5
 m.dx=-m.vel
 
 m.vida=8
 m.t_estado=0

 m.estado="patrull"
 m.alcance=12
 m.t_ataque=0
 m.golpe_hecho=false
 
 m.fs={10,40,10}
 m.f=1
 m.df=0.10
 m.flip=true
 
 -- hurt box
 m.bb={
 x1=3,
 y1=-16,
 x2=13,
 y2=0
 }

 local upd_base=m.upd

m.upd=function()

-- estados
if m.estado=="patrull" then
  
  m.dy=0

 if m.x<0 then
  m.dx=m.vel
 end

 if m.x>120 then
  m.dx=-m.vel
 end

 m.fs={10,40,10}
 m.df=0.10

 if abs(m.x-jug.x)<m.alcance then
  m.estado="alineando"
  m.dx=0
 end

elseif m.estado=="quieto" then

 m.dx=0
 m.fs={8}
 m.df=0
 m.f=1

elseif m.estado=="alineando" then

 m.dx=0
 m.fs={10,40,10}
 m.df=0.10

 if m.x<jug.x then
  m.flip=false
 else
  m.flip=true
 end

 if abs(m.y-jug.y)>2 then
  if m.y<jug.y then
   m.dy=0.5
  else
   m.dy=-0.5
  end
 else
  m.dy=0
  m.estado="atacando"
  m.t_estado=30
  m.golpe_hecho=false
 end
 
elseif m.estado=="atacando" then

 m.dx=0
 m.dy=0

 if m.t_estado > 16 then
  m.fs={77}
 elseif m.t_estado > 8 then
  m.fs={105}
 else
  m.fs={42}
 end

 m.df=0
 m.f=1

 m.t_estado-=1

 if m.t_estado<16 and m.t_estado>8 and not m.golpe_hecho then
  make_golpe(m,"malandro")
  m.golpe_hecho=true
 end

 if m.t_estado<=0 then
  m.golpe_hecho=false
  m.estado="espera"
  m.t_estado=30
 end

elseif m.estado=="espera" then

 m.dx=0
 m.dy=0
 m.fs={8}
 m.df=0
 m.f=1

 m.t_estado-=1

 if m.t_estado<=0 then
 	m.estado="patrull"

	 if m.flip then
	  m.dx=-m.vel
	 else
	  m.dx=m.vel
	 end

 end

elseif m.estado=="golpeado" then

 m.dx=0
 m.dy=0
 m.fs={12,107}
 m.df=0.15

 m.t_estado-=1

 if m.t_estado<=0 then
  m.estado="patrull"

  if m.flip then
   m.dx=-m.vel
  else
   m.dx=m.vel
  end
 end

elseif m.estado=="caido" then

 m.dx=0
 m.dy=0
 m.fs={109}
 m.df=0
 m.f=1

 m.t_estado-=1

 if m.t_estado<=0 then
  del(ents,m)
 end

end

 upd_base()

 if m.flip then
  m.offx=0
 else
  m.offx=1
 end

 -- detectar golpes
 if m.estado!="caido" then
 for e in all(ents) do
  
   if e.hb and e.duenio==jug
   and not e.golpeados[m] 
   and colision_hb_bb(e,m) then
   
   e.golpeados[m]=true

   if e.tipo=="jugador" then
    del(ents,e)
    m.vida-=1
   
   elseif e.tipo=="mochila" then
    m.vida-=2
   
   end

   if m.vida<=0 then
    m.estado="caido"
    m.t_estado=120
   else
    m.estado="golpeado"
    m.t_estado=12
   end

  end
 end
end

end


 -- draw
 m.drw=function()

  draw_ent(m)

  -- hurt box
  --draw_hurtbox(m,8)
  
  -- tamanio del sprite
  --draw_sprite_box(m,11) 
  

 end

 return m

end
-->8
-- helpers
function sx(e)
 return e.x
end

function sy(e)
 return e.y-e.alto-e.z
end

function draw_ent(e)

 local ox=e.offx or 0
 local oy=e.offy or 0

 spr(
  e.fs[flr(e.f)],
  sx(e)+ox,
  sy(e)+oy,
  2,2,
  e.flip)

end

function draw_sprite_box(e,c)

 rect(
  sx(e),
  sy(e),
  sx(e)+e.ancho,
  sy(e)+e.alto,
  c)

end

function draw_hurtbox(e,c)
 rect(
  e.x+e.bb.x1,
  e.y+e.bb.y1-e.z,
  e.x+e.bb.x2,
  e.y+e.bb.y2-e.z,
  c)
end

function draw_hitbox(e,c)
 rect(
  e.x+e.hb.x1,
  e.y+e.hb.y1-e.z,
  e.x+e.hb.x2,
  e.y+e.hb.y2-e.z,
  c)
end

function colision_hb_bb(a,b)

 return
  a.x+a.hb.x1 < b.x+b.bb.x2 and
  a.x+a.hb.x2 > b.x+b.bb.x1 and
  a.y+a.hb.y1-a.z < b.y+b.bb.y2-b.z and
  a.y+a.hb.y2-a.z > b.y+b.bb.y1-b.z

end

-- burbujeador system
function ordenar_y()

 for i=1,#ents-1 do

  for j=1,#ents-i do

   if ents[j].y > ents[j+1].y then

    local tmp=ents[j]
    ents[j]=ents[j+1]
    ents[j+1]=tmp

   end

  end

 end

end

function actualizar_camara()

	cam_x=jug.x-64

	if cam_x<0 then
		cam_x=0
	end

	if cam_x>mundo.ancho-128 then
		cam_x=mundo.ancho-128
	end

end
-->8
-- ataques

function make_golpe(duenio,tipo)

 local g={}
 
 g.duenio=duenio
 g.tipo=tipo

 g.x=duenio.x
 g.y=duenio.y
 g.z=duenio.z or 0

 g.t=6
 g.golpeados={}

 if tipo=="jugador" then

  if duenio.flip then
   g.hb={x1=-8,
         y1=-14,
         x2=5,
         y2=-4}
  else
   g.hb={x1=11,
         y1=-14,
         x2=24,
         y2=-4}
  end

 elseif tipo=="malandro" then

  if duenio.flip then
   g.hb={x1=-7,
         y1=-11,
         x2=7,
         y2=-8}
  else
   g.hb={x1=10,
         y1=-11,
         x2=22,
         y2=-8}
  end
  
elseif tipo=="mochila" then

 if duenio.flip then
  g.hb={x1=-16,
        y1=-14,
        x2=5,
        y2=-4}
 else
  g.hb={x1=11,
        y1=-14,
        x2=32,
        y2=-4}   
 end

end

 g.upd=function()
  g.t-=1
  if g.t<=0 then
   del(ents,g)
  end
 end

 g.drw=function()
  draw_hitbox(g,9)
 end

 add(ents,g)
 return g

end
-->8
-- robin hud

function dibujar_hud()

 print("vida",2,3,10)

 local ancho=flr(jug.vida/100*30)

 rect(20,3,50,6,7)
 rectfill(21,4,21+ancho-1,5,8)

end
