pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- main

modo="intro"

function _init()

 cam_x=0
 modo="intro"
 ents={}

end

function _update()

 if modo=="intro" then
  update_intro()
  return
 end

 if modo=="juego" then
  update_juego()
  return
 end
 
 if modo=="game_over" then
  update_game_over()
  return
 end

end

function update_intro()

 if btnp(4) or btnp(5) then
  iniciar_juego()
  modo="juego"
 end

end


function update_juego()

 for e in all(ents) do
  e.upd()
 end
 
 actualizar_camara()
 
 t_spawn-=1

 if t_spawn<=0 and malandros_creados<10 then
  make_malandro()
  malandros_creados+=1
  t_spawn=30
 end

end

function _draw()

 cls()

 if modo=="intro" then
  draw_intro()
  return
 end

 if modo=="juego" then
  draw_juego()
  return
 end
 
 if modo=="game_over" then
  draw_game_over()
  return
 end


end

function draw_intro()

 print("el archivo perdido",30,50,7)
 print("press x or o",32,65,6)

end

function draw_juego()

 dibujar_cielo()

 camera(cam_x,0)

 dibujar_mundo(mundo)

 ordenar_y()

 for e in all(ents) do
  e.drw()
 end
 
 dibujar_frente(mundo)
 
 camera()
 
 dibujar_hud()

end

function iniciar_juego()

 ents={}
 mundo=crear_mundo_1()

 jug=make_jugador()
 t_spawn=30
 malandros_creados=0

 
end

function update_game_over()

 if btnp(4) or btnp(5) then
  iniciar_juego()
  modo="juego"
 end

end

function draw_game_over()

 draw_juego()
 
 camera()

 print("game over",45,55,8)
 print("press x or o",34,70,6)

end
-->8
-- mundo

function dibujar_cielo()

 camera(cam_x*0.01,0)

 map(0,12,0,0,22,4)

end

function crear_mundo_1()
	local w={}

	w.tipo="calle"

	w.ancho=128*3

	w.y_min=48
	w.y_max=104

	w.color=3

	return w
end

function crear_mundo_2()
	local w={}

	w.tipo="calle"

	w.ancho=128*5

	w.y_min=60
	w.y_max=95

	w.color=8

	return w
end

function dibujar_mundo(w)

 -- mapa a lo perro
 	map(0,0,0,0,48,8)

 -- calle
	 map(0,19,0,w.y_min,48,7)
	 
end

function dibujar_frente(w)

 -- veredita
 map(0,6,0,95,48,4)

end


-->8
function make_entidad()

 local e={}

 e.x=0
 e.y=0
 e.z=0
 
 e.dx=0
 e.dy=0
 
 e.vel=1
 
 e.vida=1
 e.atacando=false
 e.t_ataque=0
 e.danio=1
 
 e.estado="quieto"
 
 e.f=1
 e.df=0.15
 e.fs={1}

 e.flip=false
 e.spr=1

 e.upd=function()
  
  if e.dx < 0 then
   e.flip=true
  elseif e.dx > 0 then
   e.flip=false
  end
  
  e.x+=e.dx
  e.y+=e.dy
  
  e.f+=e.df

  if e.f>#e.fs then
   e.f=1
  end
 
 end
      
 e.drw=function()
  spr(e.fs[flr(e.f)],e.x,e.y-e.z,2,2,e.flip)
 end

 add(ents,e)

 return e

end
-->8
-- jugador

function make_jugador()

 local j=make_entidad()

 j.ancho=16
 j.alto=16

 j.x=64
 j.y=90
 
 j.offx=0
 j.offy=0

 j.vel=1
 
 j.fs={1}

 j.vz=0
 j.salto=4
 j.gravedad=0.4
 
 j.kx=0
 
 j.atacando=false
 j.t_ataque=0
 j.estado="quieto"
 j.t_estado=0
 j.vida=100
 j.t_danio=0
 
 j.mochilazo=false
 j.golpe_mochila=false
 
 -- hurtbox del jugador
	j.bb={
     x1=4,
     y1=-16,
     x2=12,
     y2=0}
 
 local upd_base=j.upd

 j.upd=function()

  j.dx=0
  j.dy=0
  
  if j.t_danio>0 then
   j.t_danio-=1
  end
  
  -- detectar golpes enemigos
  if j.t_danio<=0 and j.estado!="muerto" then
   for e in all(ents) do
    if e.hb and e.duenio!=j and colision_hb_bb(e,j) then
     j.vida-=10
     j.t_danio=30

    if j.vida<=0 then
    j.estado="muerto"
    j.t_estado=45
    else
    j.estado="golpeado"
    j.t_estado=12
    end

    break
    end
   end
  end
  
  if j.vida<=0 and j.estado!="muerto" then
   j.estado="muerto"
   j.t_estado=45
  end

  if j.estado=="muerto" then
    j.dx=0
    j.dy=0
    j.fs={128}
    j.df=0
    j.f=1

    j.t_estado-=1

    if j.t_estado<=0 then
      modo="game_over"
  end

 upd_base()
 return
end

  if btn(0) then
   j.dx=-j.vel
   j.flip=true
  end

  if btn(1) then
   j.dx=j.vel
   j.flip=false
  end

  if btn(2) then
   j.dy=-j.vel
  end

  if btn(3) then
   j.dy=j.vel
  end

  if j.estado!="golpeado"
  and j.estado!="muerto"
  and not j.atacando
  and not j.mochilazo then

   if btnp(5) then
    j.atacando=true
    j.t_ataque=8
    make_golpe(j,"jugador")
   end

 if btnp(4) then
  j.mochilazo=true
  j.t_mochila=24
  j.golpe_mochila=false
 end

end
  --if btnp(4) and j.z==0 then
  --- j.vz=j.salto
  --end
  
  if j.flip then
   j.offx=0
  else
   j.offx=1
  end

  j.z+=j.vz
  j.vz-=j.gravedad
  
  if j.z<0 then
   j.z=0
   j.vz=0
  end
  
  if j.estado=="muerto" then
  -- no pisar muerto
  elseif j.estado=="golpeado" then
  -- no pisar golpeado
  elseif j.atacando then
   j.estado="atacando"
   
  elseif j.mochilazo then
   j.estado="mochilazo"
  
  elseif j.z > 0 then
   j.estado="saltando"

  elseif j.dx != 0 or j.dy != 0 then
   j.estado="caminando"

  else
   j.estado="quieto"
  end

  if j.estado=="golpeado" then
		 j.t_estado-=1
		 j.fs={130}
		 j.df=0
		 j.f=1

 	if j.t_estado<=0 then
  	j.estado="quieto"
 	end
 	
 elseif j.estado=="muerto" then
	 j.dx=0
	 j.dy=0
	 j.fs={128}
	 j.df=0
	 j.f=1
	
	 j.t_estado-=1
	
	 if j.t_estado<=0 then
	  modo="game_over"
	 end

	elseif j.estado=="atacando" then

 	j.t_ataque-=1
 
	 if j.t_ataque > 5 then
	  j.fs={73}
	 elseif j.t_ataque > 2 then
	  j.fs={75}
	 else
	  j.fs={73}
	 end

  j.df=0
  j.f=1

  if j.t_ataque<=0 then
   j.atacando=false
  
 	end
 	
 	elseif j.estado=="mochilazo" then

		 j.dx=0
		 j.dy=0
		
		 j.t_mochila-=1
		
		 if j.t_mochila > 12 then
		  j.fs={5}
		 elseif j.t_mochila > 6 then
		  j.fs={37}
		
		  if not j.golpe_mochila then
		   make_golpe(j,"mochila")
		   j.golpe_mochila=true
		  end
		 else
		  j.fs={37}
		 end
		
		 j.df=0
		 j.f=1
		
		 if j.t_mochila<=0 then
		  j.mochilazo=false
		  j.golpe_mochila=false
		 end

  -- caminando
  elseif j.estado=="caminando" then
   j.fs={3,33,35,33}
   j.df=0.10
  
  -- saltando
  elseif j.estado=="saltando" then
   j.fs={1}
   j.df=0
   j.f=1
  
  elseif j.estado=="quieto" then
   j.fs={1}
   j.df=0
   j.f=1
  end
  
  
  upd_base()

  if j.x<0 then
   j.x=0
  end

  if j.x>mundo.ancho-j.ancho then
   j.x=mundo.ancho-j.ancho
  end

  if j.y<mundo.y_min then
   j.y=mundo.y_min
  end

  if j.y>mundo.y_max then
   j.y=mundo.y_max
  end

 end

 j.drw=function()
  
  draw_ent(j)
	 
	 -- hurt box
	 --draw_hurtbox(j,8)
	 
	 -- caja sprite
  --draw_sprite_box(j,11)
  
 end

 return j

end
