-- mundo

function dibujar_cielo()

 camera(cam_x*0.01,0)

 map(0,12,0,0,22,4)

end

function crear_mundo_1()
	local w={}

	w.tipo="calle"

	w.ancho=128*3

	w.y_min=48
	w.y_max=104

	w.color=3

	return w
end

function crear_mundo_2()
	local w={}

	w.tipo="calle"

	w.ancho=128*3

	w.y_min=64
	w.y_max=104

	w.color=8

	return w
end

function dibujar_mundo(w)

 local mx=0
 local my=0
 local anchocalle=7

 if zona==2 then
  mx=48
  my=16
  anchocalle=5
 end


 -- mapa a lo perro
 map(mx,0,0,my,48,8)

 -- calle
	map(0,19,0,w.y_min,48,anchocalle)
	 
end

function dibujar_frente(w)
 
 local mx=0

 if zona==2 then
  mx=48
 end

 -- veredita
 map(mx,6,0,95,48,4)

end


-->8
function make_entidad()

 local e={}

 e.x=0
 e.y=0
 e.z=0
 
 e.dx=0
 e.dy=0
 
 e.vel=1
 
 e.vida=1
 e.atacando=false
 e.t_ataque=0
 e.danio=1
 
 e.estado="quieto"
 
 e.f=1
 e.df=0.15
 e.fs={1}

 e.flip=false
 e.spr=1

 e.upd=function()
  
  if e.dx < 0 then
   e.flip=true
  elseif e.dx > 0 then
   e.flip=false
  end
  
  e.x+=e.dx
  e.y+=e.dy
  
  e.f+=e.df

  if e.f>#e.fs then
   e.f=1
  end
 
 end
      
 e.drw=function()
  spr(e.fs[flr(e.f)],e.x,e.y-e.z,2,2,e.flip)
 end

 add(ents,e)

 return e

end
-->8
-- jugador

function make_jugador()

 local j=make_entidad()

 j.ancho=16
 j.alto=16

 j.x=64
 j.y=90
 
 j.offx=0
 j.offy=0

 j.vel=1
 
 j.fs={1}

 j.vz=0
 j.salto=4
 j.gravedad=0.4
 
 j.kx=0
 
 j.atacando=false
 j.t_ataque=0
 j.estado="quieto"
 j.t_estado=0
 j.vida=100
 j.t_danio=0
 
 j.mochilazo=false
 j.golpe_mochila=false
 
 -- hurtbox del jugador
	j.bb={
     x1=4,
     y1=-16,
     x2=12,
     y2=0}
 
 local upd_base=j.upd

 j.upd=function()

  j.dx=0
  j.dy=0
  
  if j.t_danio>0 then
   j.t_danio-=1
  end
  
  -- detectar golpes enemigos
  if j.t_danio<=0 
  and j.estado!="muerto" then
   for e in all(ents) do
    if e.hb and e.duenio!=j 
    and colision_hb_bb(e,j) then
     sfx(3)
     j.vida-=10
     j.t_danio=30

    if j.vida<=0 then
    j.estado="muerto"
    j.t_estado=45
    else
    j.estado="golpeado"
    j.t_estado=12
    end

    break
    end
   end
  end
  
  if j.vida<=0 
  and j.estado!="muerto" then
   j.estado="muerto"
   j.t_estado=45
  end

  if j.estado=="muerto" then
    j.dx=0
    j.dy=0
    j.fs={128}
    j.df=0
    j.f=1

    j.t_estado-=1

    if j.t_estado<=0 then
      modo="game_over"
  end

 upd_base()
 return
end

  if btn(0) then
   j.dx=-j.vel
   j.flip=true
  end

  if btn(1) then
   j.dx=j.vel
   j.flip=false
  end

  if btn(2) then
   j.dy=-j.vel
  end

  if btn(3) then
   j.dy=j.vel
  end

  if j.estado!="golpeado"
  and j.estado!="muerto"
  and not j.atacando
  and not j.mochilazo then

   if btnp(5) then
    j.atacando=true
    j.t_ataque=8
    make_golpe(j,"jugador")
    sfx(1)
   end

 if btnp(4) then
  j.mochilazo=true
  j.t_mochila=24
  j.golpe_mochila=false
  sfx(2)
 end

end
  --if btnp(4) and j.z==0 then
  --- j.vz=j.salto
  --end
  
  if j.flip then
   j.offx=0
  else
   j.offx=1
  end

  j.z+=j.vz
  j.vz-=j.gravedad
  
  if j.z<0 then
   j.z=0
   j.vz=0
  end
  
  if j.estado=="muerto" then
  -- no pisar muerto
  elseif j.estado=="golpeado" then
  -- no pisar golpeado
  elseif j.atacando then
   j.estado="atacando"
   
  elseif j.mochilazo then
   j.estado="mochilazo"
  
  elseif j.z > 0 then
   j.estado="saltando"

  elseif j.dx != 0 or j.dy != 0 then
   j.estado="caminando"

  else
   j.estado="quieto"
  end

  if j.estado=="golpeado" then
		 j.t_estado-=1
		 j.fs={130}
		 j.df=0
		 j.f=1

 	if j.t_estado<=0 then
  	j.estado="quieto"
 	end
 	
 elseif j.estado=="muerto" then
	 j.dx=0
	 j.dy=0
	 j.fs={128}
	 j.df=0
	 j.f=1
	
	 j.t_estado-=1
	
	 if j.t_estado<=0 then
	  modo="game_over"
	 end

	elseif j.estado=="atacando" then

 	j.t_ataque-=1
 
	 if j.t_ataque > 5 then
	  j.fs={73}
	 elseif j.t_ataque > 2 then
	  j.fs={75}
	 else
	  j.fs={73}
	 end

  j.df=0
  j.f=1

  if j.t_ataque<=0 then
   j.atacando=false
  
 	end
 	
 	elseif j.estado=="mochilazo" then

		 j.dx=0
		 j.dy=0
		
		 j.t_mochila-=1
		
		 if j.t_mochila > 12 then
		  j.fs={5}
		 elseif j.t_mochila > 6 then
		  j.fs={37}
		
		  if not j.golpe_mochila then
		   make_golpe(j,"mochila")
		   j.golpe_mochila=true
		  end
		 else
		  j.fs={37}
		 end
		
		 j.df=0
		 j.f=1
		
		 if j.t_mochila<=0 then
		  j.mochilazo=false
		  j.golpe_mochila=false
		 end

  -- caminando
  elseif j.estado=="caminando" then
   j.fs={3,33,35,33}
   j.df=0.10
  
  -- saltando
  elseif j.estado=="saltando" then
   j.fs={1}
   j.df=0
   j.f=1
  
  elseif j.estado=="quieto" then
   j.fs={1}
   j.df=0
   j.f=1
  end
  
  
  upd_base()

  if j.x<0 then
   j.x=0
  end

  if j.x>mundo.ancho-j.ancho then
   j.x=mundo.ancho-j.ancho
  end

  if j.y<mundo.y_min then
   j.y=mundo.y_min
  end

  if j.y>mundo.y_max then
   j.y=mundo.y_max
  end

 end

 j.drw=function()
  
  draw_ent(j)
	 
	 -- hurt box
	 --draw_hurtbox(j,8)
	 
	 -- caja sprite
  --draw_sprite_box(j,11)
  
 end

 return j

end
-->8
-- malandros

-- malandro

function make_malandro(x,y,color)

 local m=make_entidad()
 
 m.tipo="malandro"

 m.x=x or 110
 m.y=y or 90
 m.flip=true
 m.fs={10,40,10}
 m.f=1
	m.df=0.10
 
 m.color_ropa=color or colores_malandro[sig_color]
 m.ancho=16
 m.alto=16
 
 m.offx=0
 m.offy=0

 m.vel=0.5
 m.dx=-m.vel
 
 m.vida=6
 m.t_estado=0

 m.estado="patrull"
 m.alcance=12
 m.t_ataque=0
 m.golpe_hecho=false
 m.desfase_y=rnd(12)-6
 
	sig_color+=1
	if sig_color>#colores_malandro then
 	sig_color=1
	end
 
 -- hurt box
 m.bb={
 x1=3,
 y1=-16,
 x2=13,
 y2=0
 }

 local upd_base=m.upd

m.upd=function()

-- estados
if m.estado=="patrull" then
  
  m.dy=0

 if m.x<0 then
  m.dx=m.vel
 end

 if m.x>300 then
  m.dx=-m.vel
 end

 m.fs={10,40,10}
 m.df=0.10

 if abs(m.x-jug.x)<m.alcance then
  m.estado="alineando"
  m.dx=0
 end

elseif m.estado=="quieto" then

 m.dx=0
 m.fs={8}
 m.df=0
 m.f=1

elseif m.estado=="alineando" then

 m.dx=0
 m.fs={10,40,10}
 m.df=0.10

 if m.x<jug.x then
  m.flip=false
 else
  m.flip=true
 end

 local objetivo_y=jug.y+m.desfase_y

	if abs(m.y-objetivo_y)>2 then
	 if m.y<objetivo_y then
	  m.dy=0.5
	 else
	  m.dy=-0.5
	 end
	else
	 m.dy=0
	 m.estado="atacando"
	 m.t_estado=30
	 m.golpe_hecho=false
	end
 
elseif m.estado=="atacando" then

 m.dx=0
 m.dy=0

 if m.t_estado > 16 then
  m.fs={77}
 elseif m.t_estado > 8 then
  m.fs={105}
 else
  m.fs={42}
 end

 m.df=0
 m.f=1

 m.t_estado-=1

 if m.t_estado<16 
 and m.t_estado>8 
 and not m.golpe_hecho then
  make_golpe(m,"malandro")
  m.golpe_hecho=true
 end

 if m.t_estado<=0 then
  m.golpe_hecho=false
  m.estado="espera"
  m.t_estado=30
 end

elseif m.estado=="espera" then

 m.dx=0
 m.dy=0
 m.fs={8}
 m.df=0
 m.f=1

 m.t_estado-=1

 if m.t_estado<=0 then
	 m.estado="patrull"
	
	 if m.flip then
	  m.dx=-m.vel
	 else
	  m.dx=m.vel
	 end

	end

elseif m.estado=="golpeado" then
 m.dx=0
 m.dy=0
 m.fs={12,107}
 m.df=0.15

 m.t_estado-=1

 if m.t_estado<=0 then
  m.estado="patrull"

  if m.flip then
   m.dx=-m.vel
  else
   m.dx=m.vel
  end
 end

elseif m.estado=="caido" then

 m.dx=0
 m.dy=0
 m.fs={109}
 m.df=0
 m.f=1

 m.t_estado-=1

 if m.t_estado<=0 then
  del(ents,m)
 end

end

 upd_base()

 if m.flip then
  m.offx=0
 else
  m.offx=1
 end

 -- detectar golpes
 if m.estado!="caido" then
 for e in all(ents) do
  
   if e.hb and e.duenio==jug
   and not e.golpeados[m] 
   and colision_hb_bb(e,m) then
   
   e.golpeados[m]=true

   if e.tipo=="jugador" then
    del(ents,e)
    m.vida-=1
   
   elseif e.tipo=="mochila" then
    m.vida-=2
   
   end

   if m.vida<=0 then
    m.estado="caido"
    m.t_estado=120
   else
    m.estado="golpeado"
    m.t_estado=12
   end

  end
 end
end

end


 -- draw
 m.drw=function()

  pal(8,m.color_ropa)
  draw_ent(m)
  pal()
  -- hurt box
  --draw_hurtbox(m,8)
  
  -- tamanio del sprite
  --draw_sprite_box(m,11) 
  

 end

 return m

end

-- nierilander

function make_nierilander(x,y)

 local n=make_entidad()

 n.tipo="nierilander"

 n.x=x or 180
 n.y=y or 60
 n.z=0

 n.ancho=16
 n.alto=16

 n.offx=0
 n.offy=0

 n.vel=0.5
 n.dx=0
 n.dy=0

 n.vida=8
 n.t_estado=0
 n.t_botella=0

 n.estado="escabiando"
 n.alcance=16
 n.golpe_hecho=false

 
 n.fs={70}
 n.f=1
 n.df=0.05
 n.flip=true

 n.bb={
  x1=3,
  y1=-16,
  x2=13,
  y2=0
 }

 local upd_base=n.upd

 n.upd=function()
 
 if n.estado!="escabiando"
and n.estado!="caido"
and n.estado!="atacando"
and n.estado!="botellazo"
and (abs(n.x-jug.x)>90 
or abs(n.y-jug.y)>50) then

  n.estado="escabiando"
  n.dx=0
  n.dy=0
  n.f=1

 end


  if n.estado=="escabiando" then

   n.dx=0
   n.dy=0
   n.fs={70,70,70,70,132,132,132} -- escabiando
   n.df=0.08

   -- si el jugador se acerca, baja a pelear
   if abs(n.x-jug.x)<20 then
  		if n.y<mundo.y_min then
   		n.estado="entrando"
  		else
   		n.estado="alineando"
  	 end
  	end

  elseif n.estado=="entrando" then

   n.dx=0
   n.dy=0.5
   n.fs={70,68,134} -- caminando hacia abajo
   n.df=0.25

   if n.y>=mundo.y_min then
    n.y=mundo.y_min
    n.dy=0
    n.estado="alineando"
   end

  elseif n.estado=="alineando" then

 n.dx=0
 n.fs={70,68,134}
 n.df=0.25

 if n.x<jug.x then
  n.flip=false
 else
  n.flip=true
 end

 if jug.x>n.x
 and jug.x-n.x>35
 and jug.x-n.x<70
 and abs(n.y-jug.y)<8 
 and n.t_botella<=0 then

  n.dy=0
  n.estado="botellazo"
  n.t_estado=25
  n.golpe_hecho=false

 else

  if abs(n.y-jug.y)>2 then
   if n.y<jug.y then
    n.dy=0.5
   else
    n.dy=-0.5
   end
  else
   n.dy=0
   n.estado="atacando"
   n.t_estado=30
   n.golpe_hecho=false
  end

 end

  elseif n.estado=="atacando" then

   n.dx=0
   n.dy=0

   -- cambiar por sprites de ataque
   if n.t_estado>16 then
    n.fs={100}
   elseif n.t_estado>8 then
    n.fs={102}
   else
    n.fs={100}
   end

   n.df=0
   n.f=1

   n.t_estado-=1

   if n.t_estado<16
   and n.t_estado>8
   and not n.golpe_hecho then
    make_golpe(n,"malandro")
    n.golpe_hecho=true
   end

   if n.t_estado<=0 then
    n.golpe_hecho=false
    n.estado="espera"
    n.t_estado=30
   end
   
   elseif n.estado=="botellazo" then

			 n.dx=0
			 n.dy=0
			
			 if n.t_estado>14 then
			  n.fs={132}
			 elseif n.t_estado>8 then
			  n.fs={100}
			 else
			  n.fs={70}
			 end
			
			 n.df=0
			 n.f=1
			
			 n.t_estado-=1
			
			 if n.t_estado==10
			 and not n.golpe_hecho then
			  make_botella(n)
			  n.golpe_hecho=true
			 end
			
			 if n.t_estado<=0 then
			  n.golpe_hecho=false
			  n.estado="espera"
			  n.t_estado=30
			  n.t_botella=90
			 end
			 
	 elseif n.estado=="espera" then

   n.dx=0
   n.dy=0
   n.fs={70}
   n.df=0
   n.f=1

   n.t_estado-=1

   if n.t_estado<=0 then
    n.estado="alineando"
   end

  elseif n.estado=="golpeado" then

   n.dx=0
   n.dy=0
   n.fs={138}
   n.df=0.15

   n.t_estado-=1

   if n.t_estado<=0 then
    n.estado="alineando"
   end

  elseif n.estado=="caido" then

   n.dx=0
   n.dy=0
   n.fs={136}
   n.df=0
   n.f=1

   n.t_estado-=1

   if n.t_estado<=0 then
    del(ents,n)
   end

  end

  upd_base()
  
  
  if n.t_botella>0 then
 		n.t_botella-=1
		end

  if n.flip then
   n.offx=0
  else
   n.offx=1
  end

  -- detectar golpes del jugador
  if n.estado!="caido" then
   for e in all(ents) do
    if e.hb
    and e.duenio==jug
    and not e.golpeados[n]
    and colision_hb_bb(e,n) then

     e.golpeados[n]=true

     if e.tipo=="jugador" then
      del(ents,e)
      n.vida-=1
     elseif e.tipo=="mochila" then
      n.vida-=2
     end

     if n.vida<=0 then
      n.estado="caido"
      n.t_estado=120
     else
      n.estado="golpeado"
      n.t_estado=12
     end

    end
   end
  end
  
  

 end

 n.drw=function()

  draw_ent(n)

 -- if n.estado=="escabiando" then
 --  circfill(n.x+10,n.y-18,1,7)
 --  circfill(n.x+12,n.y-22,1,6)
 -- end

 end

 return n

end
-->8
-- helpers
function sx(e)
 return e.x
end

function sy(e)
 return e.y-e.alto-e.z
end

function draw_ent(e)

 local ox=e.offx or 0
 local oy=e.offy or 0

 spr(
  e.fs[flr(e.f)],
  sx(e)+ox,
  sy(e)+oy,
  2,2,
  e.flip)

end

function draw_sprite_box(e,c)

 rect(
  sx(e),
  sy(e),
  sx(e)+e.ancho,
  sy(e)+e.alto,
  c)

end

function draw_hurtbox(e,c)
 rect(
  e.x+e.bb.x1,
  e.y+e.bb.y1-e.z,
  e.x+e.bb.x2,
  e.y+e.bb.y2-e.z,
  c)
end

function draw_hitbox(e,c)
 rect(
  e.x+e.hb.x1,
  e.y+e.hb.y1-e.z,
  e.x+e.hb.x2,
  e.y+e.hb.y2-e.z,
  c)
end

function colision_hb_bb(a,b)

 return
  a.x+a.hb.x1 < b.x+b.bb.x2 and
  a.x+a.hb.x2 > b.x+b.bb.x1 and
  a.y+a.hb.y1-a.z < b.y+b.bb.y2-b.z and
  a.y+a.hb.y2-a.z > b.y+b.bb.y1-b.z

end

-- burbujeador system
function ordenar_y()

 for i=1,#ents-1 do

  for j=1,#ents-i do

   if ents[j].y > ents[j+1].y then

    local tmp=ents[j]
    ents[j]=ents[j+1]
    ents[j+1]=tmp

   end

  end

 end

end

function actualizar_camara()

	cam_x=jug.x-64

	if cam_x<0 then
		cam_x=0
	end

	if cam_x>mundo.ancho-128 then
		cam_x=mundo.ancho-128
	end

end

function enemigos_vivos()

 local c=0

 for e in all(ents) do
  if e.tipo=="malandro"
  and e.estado!="caido" then
   c+=1
  end
 end

 return c

end


-->8
-- ataques

function make_golpe(duenio,tipo)

 local g={}
 
 g.duenio=duenio
 g.tipo=tipo

 g.x=duenio.x
 g.y=duenio.y
 g.z=duenio.z or 0

 g.t=6
 g.golpeados={}

 if tipo=="jugador" then

  if duenio.flip then
   g.hb={x1=-6,
         y1=-14,
         x2=4,
         y2=-4}
  else
   g.hb={x1=12,
         y1=-14,
         x2=22,
         y2=-4}
  end

 elseif tipo=="malandro" then

  if duenio.flip then
   g.hb={x1=-7,
         y1=-11,
         x2=7,
         y2=-8}
  else
   g.hb={x1=10,
         y1=-11,
         x2=22,
         y2=-8}
  end
  
elseif tipo=="mochila" then

 if duenio.flip then
  g.hb={x1=-16,
        y1=-14,
        x2=5,
        y2=-4}
 else
  g.hb={x1=11,
        y1=-14,
        x2=32,
        y2=-4}   
 end

end

 g.upd=function()
  g.t-=1
  if g.t<=0 then
   del(ents,g)
  end
 end

 g.drw=function()
  --draw_hitbox(g,9)
 end

 add(ents,g)
 return g

end

function make_botella(n)

 local b=make_entidad()

 b.tipo="botella"
 b.duenio=n

 b.x=n.x+8
 b.y=n.y-8
 b.z=0

 b.ancho=8
 b.alto=8

 b.hb={x1=1,
 					y1=-7,
 					x2=7,
 					y2=0
	}

 b.dx=2
 b.dy=0

 b.fs={140,141,156,157}
 b.f=1
 b.df=0.25

 local upd_base=b.upd

 b.upd=function()

  upd_base()

  if colision_hb_bb(b,jug) then
		 sfx(3)
		 jug.vida-=10
		 jug.t_danio=30
		
		 if jug.vida<=0 then
		  jug.estado="muerto"
		  jug.t_estado=45
		 else
		  jug.estado="golpeado"
		  jug.t_estado=12
		 end
		
		 del(ents,b)
		end
  
  if b.x<0 or b.x>mundo.ancho then
   del(ents,b)
  end

 end

 b.drw=function()
  spr(b.fs[flr(b.f)],b.x,b.y-8,1,1,b.flip)
  --draw_hitbox(b,8)
 end

 return b

end
-->8
-- robin hud

function dibujar_hud()

 print("vida",2,3,10)

 local ancho=flr(jug.vida/100*30)

 rect(20,3,50,6,7)
 rectfill(21,4,21+ancho-1,5,8)

end
